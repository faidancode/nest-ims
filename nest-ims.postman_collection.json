            ]
        },
        {
            "name": "Warehouse",
            "item": [
                {
                    "name": "List Warehouses",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "let jsonData = {};",
                                    "try { jsonData = pm.response.json(); } catch (e) {}",
                                    "const data = jsonData.data || [];",
                                    "if (data.length > 0 && data[0].id) pm.collectionVariables.set('warehouse_id', data[0].id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/v1/warehouses?page=1&limit=10",
                            "host": [
                                "{{base_url}}"
